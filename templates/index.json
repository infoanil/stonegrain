      "type": "faq",
      "blocks": {
        "fb1431d4-92d6-48f3-833d-cfa2911d5804": {
          "type": "item",
          "settings": {
            "title": "What shipping options do you offer?",
            "content": "<p>We offer pickup, delivery and shipping options depending on which product size you select.<br/><br/><a href=\"/pages/shipping\" title=\"Pickup, Freight Shipping and Delivery Guidelines\">Learn more about our Shipping Guidelines</a>  <a href=\"/pages/shipping\" title=\"Pickup, Freight Shipping and Delivery Guidelines\"><span style=\"text-decoration:underline\">➙</span></a></p>"
          }
        },
        "166442457738b23caf-0": {
          "type": "item",
          "settings": {
            "title": "Are your organic products non-GMO too?",
            "content": "<p>Yes! All of our organic products are non-GMO also!</p>"
          }
        },
        "166442457738b23caf-1": {
          "type": "item",
          "settings": {
            "title": "Why should I buy Organic grains?",
            "content": "<p>Organic farming practices benefit the ecosystems surrounding a farm – better air, carbon sequestration and healthier soil.</p>"
          }
        },
        "166442457738b23caf-2": {
          "type": "item",
          "settings": {
            "title": "Are Organic grains good for my animals?",
            "content": "<p>Organic grains are a highly nutritious; packed with vitamins, minerals and fiber, which provide great fuel for livestock.</p>"
          }
        },
        "7202d9d7-6fbe-4b80-a6fd-038c09ff9e52": {
          "type": "item",
          "settings": {
            "title": "Do your grains contain any antibiotics or hormones?",
            "content": "<p>No. Our Organic feeds contain no antibiotics, hormones or animal by-products</p>"
          }
        },
        "c63eddc4-86e5-4989-8faf-89e3de3bb629": {
          "type": "item",
          "settings": {
            "title": "Do you offer custom feed blends?",
            "content": "<p>Yes! Our custom rations provide for the ability of farmers to curate a specialized diet for their livestock.</p>"
          }
        }
      },
