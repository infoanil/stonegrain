        "f6a9c136-bcf7-4fbe-9f7a-e82896d397f8": {
          "type": "item",
          "settings": {
            "image": "shopify://shop_images/Stone_House_Grain_Delivery_Feed_and_Grain_Truck.jpg",
            "image_rotation_degrees": -2,
            "subheading": "Bulk Feed Orders",
            "title": "Local Delivery Within 50 Miles",
            "content": "<h5><strong>ALL NEW BULK DELIVERY CUSTOMERS MUST BE PREAPPROVED.</strong></h5><ul><li><strong>Contact the sales office for a bulk delivery application.</strong></li><li>This service is available for bulk orders of grain and feed only.</li><li>We provide local delivery within a 50-mile radius of the farm address (subject to approval).</li><li>A minimum of 3 Tons of feed per order is required for local delivery.</li><li>A minimum of 1 ton bulk per feed type is required.</li><li>A minimum of 1 ton bulk per feed type is required for bulk pickups.  For pick ups of more than 1 ton of the same feed we will only fill ONE container (i.e. a wagon or multi-ton  bin).  We will NOT fill multiple containers.</li><li><strong>Bulk delivery orders MUST be placed by noon on the Tuesday of the week PRIOR to delivery.</strong></li><li>Delivery costs are $5 per mile within the 50-mile farm radius.  There is a minimum delivery charge of $50.</li></ul>",
            "button_url": "",
            "button_text": ""
          }
        }
