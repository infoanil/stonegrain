          "type": "item",
          "settings": {
            "image": "shopify://shop_images/Frieght_Shipping_Option_at_Stone_House_Farm_Square.jpg",
            "image_rotation_degrees": -2,
            "subheading": "Palleted Bags and Totes",
            "title": "LTL Freight",
            "content": "<ul><li><strong>LTL Freight is available for 1 ton paletted bag and 1 ton tote orders only. </strong></li><li>Single bag orders cannot be shipped via LTL Freight.</li><li>Stone House Grain offers Less Than Truck Load (LTL) Freight via R+L Freight.</li><li>Please allow for up to 5 business days for your order to be completed and ready to ship.</li><li>Freight quotes will be generated automatically during checkout based on the weight and destination address of the shipment.</li><li>All freight is shipped on palettes.</li><li>Please note that lift gate access on the trucks is not included in the quotes. Customers are responsible for having equipment to remove palettes upon delivery.</li></ul>",
            "button_url": "",
            "button_text": ""
          }
        }
      },
